# Supabase transaction pooler connection. Server only; never NEXT_PUBLIC.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is accepted as a fallback.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production requires persistent Supabase. The local PostgreSQL WASM adapter is dev-only.
LOCAL_DATABASE=1
