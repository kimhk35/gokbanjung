# Required server-only Postgres connection. Neon works without Supabase.
DATABASE_URL=

# Optional canonical site address. Leave blank to use the deployment address.
NEXT_PUBLIC_SITE_URL=
# Optional Better Auth overrides. By default a signing key is generated once
# and stored in the server-only ggc_auth_config table. Do not expose it publicly.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Optional AI features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
