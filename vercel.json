{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/daniel-week-46": false,
      "codex/home-study-plan-fallback": false,
      "codex/study-reader-main": false,
      "codex/mobile-reader-focus": false,
      "claude/auth-restore": false,
      "codex/week47-connected-reading": false,
      "codex/week48-six-day-reading": false,
      "codex/reader-previous-material": false,
      "codex/study-learning-points": false,
      "claude/reconnect-neon-url": false
    }
  },
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "regions": ["icn1"],
  "headers": [
    { "source": "/card-backgrounds/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
